QUAD_VERSION=latest                # Docker image tag (latest, sha-abc1234, etc.)
DISCORD_TOKEN=your-bot-token-here
RECORDING_DIR=./recordings
TEAM_TAG=
TEAM_NAME=
LOG_LEVEL=info
HEALTH_PORT=3000
# HEALTH_BIND=127.0.0.1          # Compose only: host address the health port is published on

# Processing module
ANTHROPIC_API_KEY=             # For Claude analysis (optional)
WHISPER_MODEL=small            # tiny/base/small/medium/turbo
PLAYER_QUERY=paradoks          # QW Hub player search term
PLAYER_NAME_MAP=paradoks:ParadokS,zerohero5954:zero,fs_razor:Razor,grisling2947:grisling
PROCESSING_AUTO=true           # Auto-run fast pipeline after recording
PROCESSING_TRANSCRIBE=false    # Auto-run transcription (slow)
PROCESSING_INTERMISSIONS=true  # Extract between-map discussion

# Standin module (optional — module skips if not configured)
FIREBASE_SERVICE_ACCOUNT=./service-account.json   # Path to JSON file or inline JSON string
# FIREBASE_STORAGE_BUCKET=      # Defaults to <projectId>.firebasestorage.app
SCHEDULER_URL=https://matchscheduler.web.app       # MatchScheduler URL for preferences deep-link

# Mumble module (optional — module skips if MUMBLE_HOST not set)
MUMBLE_HOST=mumble              # Docker service name (or IP for dev: 83.172.66.214)
MUMBLE_PORT=64738               # Default Mumble port
MUMBLE_BOT_USERNAME=SuperUser   # Use SuperUser for channel mgmt until M2 registers QuadBot
MUMBLE_PASSWORD=                # SuperUser password (MUMBLE_SUPERUSER_PASSWORD value)
MUMBLE_ICE_SECRET=              # ICE admin API secret; compose also feeds it to the mumble service (ICESECRETWRITE)
MUMBLE_PUBLIC_HOST=             # Public hostname written into mumbleConfig.serverAddress (mumble.slipgate.me in prod). Required once a team activates Mumble.
# MUMBLE_AUTO_RECORD=true       # Set false to disable Mumble auto-record (default on when MUMBLE_HOST is set)
# MUMBLE_RECORDING_DIR=         # Defaults to RECORDING_DIR

# Compose-only (read by the mumble and acme services, not by the bot)
MUMBLE_SUPERUSER_PASSWORD=      # murmur SuperUser password (MUMBLE_PASSWORD above should match)
MUMBLE_SERVER_PASSWORD=         # Optional server join password (empty = open)
CF_Token=                       # Cloudflare API token, Zone:DNS:Edit on slipgate.me, for the acme sidecar
CF_Zone_ID=                     # Cloudflare zone id for slipgate.me
